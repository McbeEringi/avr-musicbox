{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avr-musicbox",
	"compatibility_date": "2026-11-09",
	"build":{"command":"bun 6ca-ssg","watch_dir":["src","modules.mjs"]},
	"routes":[
		{"pattern":"avr.6ca.me/avr-musicbox/*","zone_name":"6ca.me"}
	],
	"assets":{"directory":"./dst","not_found_handling":"404-page"},
	"observability":{"enabled":true},
	"upload_source_maps": true
}
